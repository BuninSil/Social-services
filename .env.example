# Порт и интерфейс, на которых слушает сайт.
PORT=8080
HOST=0.0.0.0

# Где лежат база и загруженные файлы.
VO_DATA_DIR=./data
VO_UPLOAD_DIR=./uploads

# Секрет подписи сессий. Если не задан — генерируется в VO_DATA_DIR/session.secret.
# VO_SECRET=длинная-случайная-строка

# --------------------------------------------------------------- RetroCore
# Вход участников сети RetroCore («Вариант Б» из инструкции сети).
# Приложение заводится в панели сети: Панель сервера → Приложения → Новое.
# Адрес возврата должен совпадать символ в символ с тем, что указан там.
#
# RC_BASE=http://88.87.70.78:8080
# RC_CLIENT_ID=ваш-client_id
# RC_CLIENT_SECRET=rcs_ваш-секрет
# RC_REDIRECT_URI=http://192.168.1.50:8080/connect/callback
#
# Пока эти три строки не заданы, кнопки «Войти через RetroCore» просто нет,
# сайт работает на обычных логинах с паролями.
