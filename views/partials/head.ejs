<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<title><%= typeof title !== 'undefined' && title ? title + ' | ВОнлайне' : 'ВОнлайне' %></title>
<link rel="stylesheet" href="/css/<%= theme === 'vo' ? 'vo' : 'vo-' + theme %>.css">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
</head>
<body<% if (me) { %> data-uid="<%= me.id %>" data-csrf="<%= csrf %>"<% } %>>

<div id="header">
  <div id="header_in">
    <a id="logo" href="<%= me ? '/feed' : '/' %>"><span class="logo_box">ВО</span>ВОнлайне</a>
    <% if (me) { %>
      <form id="head_search" action="/search" method="get">
        <input class="head_q" type="text" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>"
               placeholder="поиск людей и записей">
      </form>
      <div id="head_nav">
        <a href="/id<%= me.id %>"><%= me.first_name %> <%= me.last_name %></a>
        <span class="sep">|</span>
        <a href="/settings">Мои Настройки</a>
        <span class="sep">|</span>
        <a href="/help">Помощь</a>
        <span class="sep">|</span>
        <form class="act" method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" class="link_btn head_exit">Выход</button>
        </form>
      </div>
    <% } else { %>
      <div id="head_nav"><a href="/login">Вход</a></div>
    <% } %>
    <div class="clear"></div>
  </div>
</div>

<div id="live_notice" hidden></div>

<div id="page">
<% if (me) { %>
  <div id="side">
    <div class="me">
      <a href="/id<%= me.id %>"><img src="<%= avatar(me, 'thumb') %>" width="80" alt=""></a>
      <div class="name"><a href="/id<%= me.id %>"><%= me.first_name %> <%= me.last_name %></a></div>
    </div>
    <%- include('leftmenu', { nav: typeof nav !== 'undefined' ? nav : '' }) %>
    <div class="side_note small">
      Локальная сеть.<br>Всё тут между своими.
    </div>
  </div>
  <div id="content">
<% } else { %>
  <div id="content_wide">
<% } %>
