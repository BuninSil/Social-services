<form class="wall_form block" method="post" action="<%= action %>" enctype="multipart/form-data">
  <div class="block_body">
    <textarea class="text" name="text" maxlength="4000" placeholder="Что у Вас нового?"></textarea>
    <div class="wf_foot">
      <button class="button button_blue" type="submit">Отправить</button>
      <span class="right">Прикрепить фотографию: <input type="file" name="photo" accept="image/*"></span>
    </div>
  </div>
</form>
