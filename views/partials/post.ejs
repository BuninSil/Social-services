<div class="post<%= post.pinned ? ' pinned' : '' %>" id="post<%= post.id %>">
  <div class="ava">
    <a href="/id<%= post.author.id %>"><img src="<%= avatar(post.author, 'thumb') %>" width="50" alt=""></a>
  </div>
  <div class="body">
    <div class="phead">
      <a class="author" href="/id<%= post.author.id %>"><%= u.fullName(post.author) %></a>
      <% if (post.owner_type === 'user' && post.owner && post.owner.id !== post.author.id) { %>
        <span class="to">&rarr;</span>
        <a href="/id<%= post.owner.id %>"><%= u.fullName(post.owner) %></a>
      <% } %>
      <% if (post.owner_type === 'group' && post.owner && showOwner) { %>
        <span class="to">&rarr;</span>
        <a href="/club<%= post.owner.id %>"><%= post.owner.name %></a>
      <% } %>
      <a class="date" href="/post/<%= post.id %>"><%= u.vkDate(post.created_at) %></a>
      <% if (post.edited_at) { %><span class="date">(изменено)</span><% } %>
      <% if (post.pinned) { %><span class="pin_mark">закреплённая запись</span><% } %>
    </div>

    <% if (post.text) { %><div class="ptext"><%- u.text2html(post.text) %></div><% } %>
    <%- include('attachments', { items: post.attachments }) %>

    <% if (post.source) { %>
      <div class="repost">
        <div class="rhead">
          <a href="/id<%= post.source.author.id %>"><img src="<%= avatar(post.source.author, 'thumb') %>"
            width="32" height="32" alt=""></a>
          <a class="author" href="/id<%= post.source.author.id %>"><%= u.fullName(post.source.author) %></a>
          <a class="date" href="/post/<%= post.source.id %>"><%= u.vkDate(post.source.created_at) %></a>
        </div>
        <% if (post.source.text) { %><div class="ptext"><%- u.text2html(post.source.text) %></div><% } %>
        <%- include('attachments', { items: post.source.attachments }) %>
      </div>
    <% } %>

    <div class="pactions">
      <a href="#" class="like_link <%= post.liked ? 'liked' : '' %>" data-type="post" data-id="<%= post.id %>"><%=
        (post.liked ? 'Мне не нравится' : 'Мне нравится') + (post.likes ? ' (' + post.likes + ')' : '') %></a>
      <a href="#" class="reply_link" data-id="<%= post.id %>">Комментировать<%=
        post.comments.length ? ' (' + post.comments.length + ')' : '' %></a>
      <%- act(csrf, '/post/' + post.id + '/repost', 'Рассказать друзьям' + (post.reposts ? ' (' + post.reposts + ')' : ''), { back: back, cls: 'small_act' }) %>
      <% if (post.likes) { %><a href="/likes/post/<%= post.id %>?back=<%= encodeURIComponent(back) %>">кто оценил</a><% } %>
      <% if (post.author_id === me.id) { %>
        <a href="/post/<%= post.id %>/edit?back=<%= encodeURIComponent(back) %>">Редактировать</a>
      <% } %>
      <% if (canDelete) { %>
        <%- act(csrf, '/post/' + post.id + '/pin', post.pinned ? 'Открепить' : 'Закрепить', { back: back, cls: 'small_act' }) %>
        <%- act(csrf, '/post/' + post.id + '/delete', 'Удалить', { back: back, cls: 'small_act', confirm: 'Удалить запись?' }) %>
      <% } %>
    </div>
  </div>
  <div class="clear"></div>

  <% if (post.comments.length) { %>
    <div class="replies">
      <% post.comments.forEach(function (c) { %>
        <div class="reply" id="comment<%= c.id %>">
          <div class="ava"><a href="/id<%= c.author_id %>"><img
            src="<%= avatar({ avatar: c.avatar }, 'thumb') %>" width="32" height="32" alt=""></a></div>
          <div class="body">
            <a class="author" href="/id<%= c.author_id %>"><%= c.first_name %> <%= c.last_name %></a>
            <span class="date"><%= u.vkDate(c.created_at) %></span>
            <% if (c.edited_at) { %><span class="date">(изменено)</span><% } %>
            <a href="#" class="reply_link small" data-id="<%= post.id %>" data-mention="<%= c.login %>">ответить</a>
            <% if (me && (c.author_id === me.id || canDelete)) { %>
              <%- act(csrf, '/comment/' + c.id + '/delete', 'удалить', { back: back, cls: 'small_act gray', confirm: 'Удалить комментарий?' }) %>
            <% } %>
            <div><%- u.text2html(c.text) %></div>
          </div>
          <div class="clear"></div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <% if (me) { %>
    <form class="reply_form" id="reply_form_<%= post.id %>" method="post"
          action="/comment?type=post&amp;id=<%= post.id %>" hidden>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="back" value="<%= back %>">
      <textarea class="text" name="text" maxlength="2000" placeholder="Ваш комментарий..."></textarea>
      <div><button class="button" type="submit">Отправить</button>
        <span class="gray small">Ctrl+Enter — отправить</span></div>
    </form>
  <% } %>
</div>
