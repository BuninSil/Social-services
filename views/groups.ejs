<%- include('partials/head', { title: 'Группы', nav: 'groups' }) %>

<h1 class="page_title">
  <%= mode === 'all' ? 'Все группы' : (owner.id === me.id ? 'Мои группы' : 'Группы — ' + u.fullName(owner)) %>
  <span class="right">
    <a href="/groups/all">Все группы</a> &middot; <a href="/groups/new">Создать группу</a>
  </span>
</h1>

<div class="block">
  <div class="block_body tight">
    <% if (!groups.length) { %><div class="empty" style="padding:10px">Групп пока нет.</div><% } %>
    <% groups.forEach(function (g) { %>
      <div class="group_row">
        <div class="ava"><a href="/club<%= g.id %>"><img src="<%= gavatar(g) %>" width="60" height="60" alt=""></a></div>
        <div class="body">
          <div class="name"><a href="/club<%= g.id %>"><%= g.name %></a></div>
          <div class="gray"><%= u.pluralCount(g.members, 'участник', 'участника', 'участников') %></div>
          <% if (g.description) { %><div><%= u.trim(g.description, 140) %></div><% } %>
        </div>
        <div class="clear"></div>
      </div>
    <% }); %>
  </div>
</div>

<%- include('partials/foot') %>
