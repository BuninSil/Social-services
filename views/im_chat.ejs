<%- include('partials/head', { title: 'Диалог с ' + u.fullName(peer), nav: 'im' }) %>

<h1 class="page_title">
  <a href="/id<%= peer.id %>"><%= u.fullName(peer) %></a>
  <span class="right"><a href="/im">Все диалоги</a></span>
</h1>
<div class="gray" style="margin-bottom:8px"><%= u.lastSeen(peer) %></div>

<div class="block">
  <div class="block_head">История переписки</div>
  <div id="chat" data-peer="<%= peer.id %>">
    <% if (!messages.length) { %><div class="empty">Сообщений пока нет. Напишите первым.</div><% } %>
    <% messages.forEach(function (m) { %>
      <div class="msg <%= m.from_id === me.id ? 'out' : 'in' %>">
        <div class="ava"><img src="<%= avatar(m.from_id === me.id ? me : peer, 'thumb') %>" width="32" height="32" alt=""></div>
        <div class="body">
          <a class="author" href="/id<%= m.from_id %>"><%= m.from_id === me.id ? me.first_name : peer.first_name %></a>
          <span class="date"><%= u.vkDate(m.created_at) %></span>
          <div><%- u.text2html(m.text) %></div>
        </div>
        <div class="clear"></div>
      </div>
    <% }); %>
  </div>
  <div class="block_foot">
    <form id="send_form" method="post" action="/im/<%= peer.id %>">
      <textarea class="text" name="text" maxlength="4000" placeholder="Введите сообщение... (Ctrl+Enter — отправить)"></textarea>
      <div class="sf_foot"><button class="button button_blue" type="submit">Отправить</button></div>
    </form>
  </div>
</div>

<%- include('partials/foot') %>
