<%- include('partials/head', { title: 'Мои Сообщения', nav: 'im' }) %>

<h1 class="page_title">Мои Сообщения
  <span class="right"><a href="/friends">Написать другу</a></span></h1>

<div class="block">
  <div class="block_head">Диалоги <span class="right"><%= dialogs.length %></span></div>
  <div class="block_body tight">
    <% if (!dialogs.length) { %>
      <div class="empty" style="padding:10px">Переписок пока нет.</div>
    <% } %>
    <% dialogs.forEach(function (d) { %>
      <div class="dlg_row <%= d.unread ? 'unread' : '' %>">
        <div class="date"><%= u.shortDate(d.created_at) %></div>
        <div class="ava"><a href="/im/<%= d.peer.id %>"><img src="<%= avatar(d.peer, 'thumb') %>" width="50" height="50" alt=""></a></div>
        <div class="body">
          <div class="name"><a href="/im/<%= d.peer.id %>"><%= u.fullName(d.peer) %></a>
            <% if (d.unread) { %><span class="cnt" style="background:#d14836;color:#fff;padding:0 4px"><%= d.unread %></span><% } %>
          </div>
          <div class="preview"><%= d.outgoing ? 'Вы: ' : '' %><%= d.preview %></div>
        </div>
        <div class="clear"></div>
      </div>
    <% }); %>
  </div>
</div>

<%- include('partials/foot') %>
